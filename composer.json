{
    "name": "manvepa/randomix",
    "description": "Aplicación web para selección aleatoria de estudiantes desde archivos Excel",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "maennchen/zipstream-php": "3.1.2",
        "phpoffice/phpspreadsheet": "^5.10",
        "tecnickcom/tc-lib-pdf": "8.81",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Randomix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Randomix\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": true,
        "platform": {
            "php": "8.2.12"
        }
    }
}
